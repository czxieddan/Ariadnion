schema = 1
materials-directory = ".ahcl"
languages:
  - "rust"

[project]
name = "Ariadnion"
canonical-repository = "https://github.com/czxieddan/Ariadnion"
canonical-branch = "master"
right-holders:
  - "czxieddan"
contact = "czxieddan@gmail.com"
# This is the first AHCL adoption; the 1.1 migration is recorded separately.
adoption-date = "2026-07-29"

[license]
version = "1.1"
special-authorization-channel = "licensing@aperip.com"

[generation]
strict-license-files = true

# Use targeted license, dependency, and third-party commands. Project-wide
# starter generation cannot represent the existing adoption/restriction history
# or the public testing-material gap in AHCL-SOURCE.md.
[rust.cargo]
lock-mode = "locked"
# The root manifest already covers ariadnion-core. Every optional crate and
# composition retains its independent locked resolution boundary.
